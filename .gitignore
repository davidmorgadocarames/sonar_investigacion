# Audio: nunca entra en git sin aprobación expresa (regla 4)
# (sin distinguir mayúsculas: Foo.WAV también queda fuera)
*.[wW][aA][vV]
*.[fF][lL][aA][cC]
*.[mM][pP]3
*.[oO][gG][gG]
*.[aA][iI][fF]
*.[aA][iI][fF][fF]

# Datos y salidas: se conserva solo el .gitkeep para que la carpeta exista al clonar
datasets/raw/*
!datasets/raw/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep
outputs/*
!outputs/.gitkeep

# Secretos
.env

# Python
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/

# Ronda 3 (D-024, ajuste 2): todos los pesos en disco; en git solo un modelo representativo por red
models/round3/*
!models/round3/representative/
