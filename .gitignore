# Audio: nunca entra en git sin aprobación expresa (regla 4)
*.wav
*.flac
*.mp3
*.ogg
*.aif
*.aiff

# Datos y salidas: se conserva solo el .gitkeep para que la carpeta exista al clonar
datasets/raw/*
!datasets/raw/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep
outputs/*
!outputs/.gitkeep

# Secretos
.env

# Python
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
